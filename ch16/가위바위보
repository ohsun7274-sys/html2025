<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>가위바위보(프롬프트)</title>
</head>
<body>

<script>
    const userChoice = prompt("가위, 바위, 보 중 하나를 입력하세요:");

    if (!userChoice || !["가위", "바위", "보"].includes(userChoice)) {
        alert("올바른 값을 입력하세요!");
    } else {
        const choices = ["가위", "바위", "보"];
        const computerChoice = choices[Math.floor(Math.random() * 3)];
        let result = "";

        if (userChoice === computerChoice) {
            result = "비겼습니다!";
        } else if (
            (userChoice === "가위" && computerChoice === "보") ||
            (userChoice === "바위" && computerChoice === "가위") ||
            (userChoice === "보" && computerChoice === "바위")
        ) {
            result = "당신이 이겼습니다!";
        } else {
            result = "컴퓨터가 이겼습니다!";
        }

        alert(
            "당신: " + userChoice +
            "\n컴퓨터: " + computerChoice +
            "\n\n결과: " + result
        );
    }
</script>

</body>
</html>
